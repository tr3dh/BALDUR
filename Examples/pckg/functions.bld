assert(calledAs(__Include__), __script__ + " is an Include and shouldnt be executed directly")

//
fetch backend ["core", "tensor"]

decl getNumOfVoigtComponents(int dimension){

    double dimensionDb = double(dimension)
    return [int(dimensionDb * (dimensionDb + 1) / 2)]
}

//
decl factorial(int ref member){
    
    if(member <= 1){ return 1 }
    return [member * factorial(member - 1)]
}

//
decl ffactorial(int ref member){

    if(member <= 0){ return 1 }
    return [member * ffactorial(member - 2)]
}

// Taylorreihenfunktion, die Ableitungen als externe Nodes mit '_{order}' einsetzt
decl emplcXtNodesTaylorSeries(tExpr ref function, tExpr ref x, int seriesOrder){
    return [ <- taylorSeries(function, x, seriesOrder, false, false) ]
}

// Taylorreihenfunktion, die Ableitungen anstellt
decl emplcDiffsTaylorSeries(tExpr ref function, tExpr ref x, int seriesOrder){
    return [ <- taylorSeries(function, x, seriesOrder, true, false) ]
}

// Wrapped taylorSeries so, dass automatisch Ableitungen und keine externen Nodes genutzt werden
// und keine Tangenten zurückgegeben werden
decl taylorSeries(tExpr ref function, tExpr ref x, int seriesOrder){

    return [ <- taylorSeries(function, x, seriesOrder, true, false) ]
}

// Wrapped taylorSeries so, dass automatisch keine Tangenten zurückgegeben werden
decl taylorSeries(tExpr ref function, tExpr ref x, int seriesOrder, bool emplaceDiffs){

    return [<- taylorSeries(function, x, seriesOrder, emplaceDiffs, false)]
}

//
decl taylorSeries(tExpr ref function, tExpr ref x, int seriesOrder, bool emplaceDiffs, bool returnTangents){

    //
    tExpr res
    
    args tangents

    //
    for(int order = 0, order < seriesOrder + 1, order++){
        
        //
        static{ tExpr [tmp, tangent] }

        //
        tangent = { if(emplaceDiffs){ return { diff(function, x, order) } }; \
            else { return { diff(function, x, order)->asExternalNode(function->getLabel() + string(order)) } }}

        //
        tangents->emplace(<+tangent)
        tmp = (1.0/factorial(order)) * tangent
        
        // momentane Lösung statt exponential Funktion
        for(int i = 0, i < order, i++){

            rIf([tmp->getOrder(), x->getOrder()] == [0,0]){ tmp *= x }
            else rIf([tmp->getOrder(), x->getOrder()] == [1,1]){ tmp .= x }
            else{ tmp := x }
        }

        // Hier wird x durch konkreten Wert x0 ersetzt
        res += wrpSimplified(tmp)
    }

    wrpSimplify(res)

    return { if(returnTangents){ return [res, tangents] }; else{ return [res] } }
}

//
int g_unwrapComplexityThreshold = 200000000

//
decl wrpSimplify(tExpr ref expr){

    // //
    // slog("simplifiziere", expr->getNumOfNodes(), "Nodes")

    //
    if(expr->getNumOfNodes() > g_unwrapComplexityThreshold){

        //
        slog("Simplifizierung geschieht aufgrund des zu komplexen Ausdrucks ohne vorherige Anpassung der Packungsstruktur")
        slog("Komplexität des Ausdrucks", expr->getNumOfNodes())

        simplify(expr)
        return {}
    }

    // Wenn unwrapOperands bereits auf false gesetzt ist unterscheidet ist wrpSimplify gleichbedeutend mit simplify
    if(!getUnwrapOperands()){
        
        simplify(expr)
        return {}
    }
    
    // Flag muss geändert werden damit rebuild beim simplify nicht wieder alles entpackt
    setUnwrapOperands(false)

    //
    expr = wrap(expr)
    simplify(expr)

    //
    setUnwrapOperands(true)

    expr = unwrap(expr)
    simplify(expr)
}

decl wrpSimplified(tExpr expr){

    wrpSimplify(expr)
    return [<-expr]
}

decl toWrappedIDN(tExpr ref expr){

    bool tmp = getUnwrapOperands()

    setUnwrapOperands(false)
    tIdn res = toIDN(wrap(expr))

    setUnwrapOperands(tmp)

    return [<-res]
}

decl toUnwrappedIDN(tExpr ref expr){

    bool tmp = getUnwrapOperands()

    setUnwrapOperands(true)
    tIdn res = toIDN(unwrap(expr))

    setUnwrapOperands(tmp)

    return [<-res]
}

//
decl requireDiffs(int ref order, args tangents, tExpr ref dExpr){
    
    //
    for(int i = 0, i < tangents->size(), i++){

        static{ tExpr ref expr }
        expr << tangents->get(i)

        requireDiffs(order, expr, dExpr)

        if(i == tangents->size() - 1){ dref expr }
    }
}

//
decl removeRequiredDiffs(int ref order, args ref tangents, tExpr ref dExpr){

    //
    for(int i = 0, i < tangents->size(), i++){

        static{ tExpr ref expr }
        expr << tangents->get(i)

        removeRequiredDiffs(order, expr, dExpr)

        if(i == tangents->size() - 1){ dref expr }
    }
}

//
decl requireDiffs(int ref order, tExpr ref expr, tExpr ref dExpr){
    
    return [requireDiffs(order, expr, dExpr, expr->getLabel(), dExpr->getLabel())]
}

//
decl removeRequiredDiffs(int ref order, tExpr ref expr, tExpr ref dExpr){

    return [removeRequiredDiffs(order, expr, dExpr, expr->getLabel(), dExpr->getLabel())]
}

//
decl requireDiffs(int ref order, tExpr ref expr, tExpr ref dExpr, string ref exprLabel, string ref dExprLabel){

    // taylorReihen enthalten ableitungen 1 bis orderTSM
    for(int i = 1, i < order + 1, i++){

        static{
            string [prevTExprLabel, currentTExprLabel] = exprLabel, " "
            tExpr [prevDiff, currentDiff] = expr, tExpr()
        }

        // prevDiff muss hier geupdated werden, da gesetzte Ableitungsregel aus dem letzten durchlauf
        // berücksichtig werden soll
        currentTExprLabel = "d" + exprLabel + string(i) + "_d" + dExprLabel + string(i)
        prevDiff, currentDiff = diff(expr, dExpr, i-1), diff(expr, dExpr, i),

        //
        setDiff(prevDiff->asExternalNode(prevTExprLabel), dExpr, currentDiff->asExternalNode(currentTExprLabel))
        
        //
        prevTExprLabel = currentTExprLabel
    }
}

//
decl removeRequiredDiffs(int ref order, tExpr ref expr, tExpr ref dExpr, string ref exprLabel, string ref dExprLabel){

    // taylorReihen enthalten ableitungen 1 bis orderTSM
    for(int i = 1, i < order + 1, i++){

        static{
            string [prevTExprLabel, currentTExprLabel] = exprLabel, " "
            tExpr [prevDiff, currentDiff] = expr, tExpr()
        }

        // prevDiff muss hier geupdated werden, da gesetzte Ableitungsregel aus dem letzten durchlauf
        // berücksichtig werden soll
        currentTExprLabel = "d" + exprLabel + string(i) + "_d" + dExprLabel + string(i)
        prevDiff, currentDiff = diff(expr, dExpr, i-1), diff(expr, dExpr, i),

        //
        removeEmplacedDiff(prevDiff->asExternalNode(prevTExprLabel), dExpr)
        
        //
        prevTExprLabel = currentTExprLabel
    }
}

decl exp(tExpr ref x, int ref order){ return [exp(x, order, true)] }

decl exp(tExpr ref x, int ref order, bool simplifyResult){

    //
    tExpr res 

    //
    for(int i = 0, i < order + 1, i++){

        res += (1.0/factorial(i)) * (x ^ i) 
    }

    if(simplifyResult){ wrpSimplify(res) }
    return res
}

decl smplfDiff(tExpr ref expr, tExpr ref dExpr, int amount){

    tExpr tmp <+ expr

    for(int i = 0, i < amount + 1, i++){

        tmp \diff= dExpr
        wrpSimplify(tmp)
    }

    return tmp
}


// Standard Julia Skript Generierung
decl stdGenerateJuliaString(tExpr ref expr, string ref resLabel, string ref filePath){

    // Umwandlung in Indexnotation, Erzeugen des Juliaskripts, schreiben des Skripts in Datei
    toWrappedIDN(expr) -> toJuliaString(resLabel) -> writeToFile(filePath)
}

// Julia Skript Generierung mit Common Subexpression Substitution (CSS)
decl cssGenerateJuliaString(tExpr ref expr, string ref resLabel, string ref filePath){

    // Funktion nimmt einen Ausdruck entgegen, wandelt ihn in Indexnotation um, substituiert
    // mehrfach im Ausdruck auftretenden Teilausdrücke und erzeugt ein Juliaskript, dass die diese
    // Abhängigkeiten vorab ermittelt und danach nur noch an die entsprechenden Stellen einsetzt

    // Veranschaulichung `expr = (S . (E . (epsilon - epsilon_vp))) . (S . (E . (epsilon - epsilon_vp))) . (C + E)`

    // Erzeugen einer Liste aller Teilausdrücke des Ausdurcks
    // Veranschaulichung `[S . (E . (epsilon - epsilon_vp)), E . (epsilon - epsilon_vp), epsilon - epsilon_vp, epsilon, epsilon_vp, C + E, C, E]` 
    args uniqueExprSubexprs = expr -> getUniqueNodes()
    args commonSubexprs

    // Ausdrücke rausschreiben die Mehrfach im Ausdruck vorkommen und keine externen Nodes sind
    // Veranschaulichung `[S . (E . (epsilon - epsilon_vp)), E . (epsilon - epsilon_vp), epsilon - epsilon_vp]`
    for(int i = 0, i < [uniqueExprSubexprs -> size()], i++){
        
        // Referenz auf aktuelles Listenelement
        static{ tExpr ref lhs }
        lhs << [uniqueExprSubexprs -> get(i)]

        // Abbruch wenn aktuelle Node eine externe Node ist oder weniger als zwei Mal (> nur einmal) vorkommt
        // Damit eignet sie sich nicht für die Substitution
        //
        // Veranschaulichung
        // * `E . (epsilon - epsilon_vp)` kommt zwei mal vor und wird folglich rausgeschrieben
        // * `C + E` kommt einmal vor und wird folglich nicht für die Substitution vorgemerkt
        // * `epsilon` kommt mehrfach vor ist aber eine externe Node und deshalb nicht substituierbar
        if(lhs -> isExternalNode() || expr -> countOccurences(lhs) < 2){ continue }
        
        // Eintrag in zu substituierende Ausdrücke
        commonSubexprs -> emplace(lhs)

        // Cleanup
        if(i == uniqueExprSubexprs -> size()){ dref lhs }
    }

    // Abbruchsteuerung der Sortiertung
    bool isExprSorted = false

    // Da die Abhängigkeiten im Rahmen des Julia-Skripts nacheinander (in einer bestimmten Reihenfolge) ermittelt
    // und dann ineinander eingesetzt werden müssen sie so vorsortiert werden, dass die Ausdrücke in die eingesetzt wird
    // nach den Ausdrücken die eingesetzt werden ermittelt wird
    //
    // Veranschaulichung
    // `(epsilon - epsilon_vp)` wird substituiert, der Term `E . (epsilon - epsilon_vp)` bzw. `E . DependencieX` wird von der
    // Substitution bzw. der evaluierten Abhängigkeit abhängig gemacht und soll deshalb erst nach `(epsilon - epsilon_vp)` berechnet werden

    // Erweiterter Buble-Sort (> Es werden nicht nur die Nachbarn gegengecheckt sondern alle möglichen Kombis)
    while(!isExprSorted){
        
        // aktuell betrachtete Komponenten, die im erweiterten Bublesort verglichen werden
        static{ tExpr ref [lhs, rhs] }

        // Ausdruck wird als sortiert markiert, wenn der Sortierschritt keine Unstimmigkeit mehr findet
        // wird die Schleife vor dem nächsten Frame abgebrochen
        isExprSorted = true

        // Jeweils zwei Komponenten auswählen
        for(int i = 0, i < commonSubexprs -> size() - 1, i ++){

            // Referenzierung erster Komponente
            lhs << commonSubexprs -> get(i)

            //
            for(int j = i + 1, j < commonSubexprs -> size(), j ++){

                // Referenzierung zweiter Komponente
                rhs << commonSubexprs -> get(j)

                // Wenn vordere Komponente die hintere nicht enthält, erfordert diese keine vorherige
                // Berechnung der ersten
                // Damit ist eine Umsortierung nicht nötig
                if(!lhs -> contains(rhs) || lhs == rhs){ continue }
                
                // Swap wenn Umsortierung notwendig ist und Reihenfolge des Komponentenpaars inkosisten
                // Vermerken der gefundenen Inkonsistenz für Abbruchsfall
                lhs <> rhs
                isExprSorted = false 
            }
        }

        // Cleanup bei Austritt aus der Schleife
        if(isExprSorted){ dref [lhs, rhs] }
    }

    // Zuweisung von Substitutionsobjekten

    // Veranschaulichung
    // `commonSubexprs = [epsilon - epsilon_vp, E . (epsilon - epsilon_vp), ...]`
    // `commonSubexprsKeys = [Dependencie_1, Dependencie_2, ...]`

    // Liste mit entsprechenden externen Nodes für die mehrfach gefundene Teilausdrücke substituiert werden sollen
    args commonSubexprsKeys

    // Counter für Labelvergabe
    int keyCounter = 0

    // Alle Substitutionskeys erstellen
    for(int i = 0, i < commonSubexprs -> size(), i ++){
        
        commonSubexprsKeys -> emplace(commonSubexprs -> get(i) -> asExternalNode("Deps" + string(keyCounter++)))
    }

    // Abgleich ob gleich viele Substitutionskeys wie Substitutionsterme vorhanden sind
    requires {commonSubexprs -> size() == commonSubexprsKeys -> size()} "Invalide Zuordnung von Substitutionslabeln zu Substitutionsinhalten"

    // Die Teilausdrücke, die von anderen Teilausdrücken, die substituiert werden, abhängig sind werden entsprechen substituiert

    // Veranschaulichung
    // `commonSubexprs = [epsilon - epsilon_vp, E . (epsilon - epsilon_vp), S . (E . (epsilon - epsilon_vp)), ...]`
    // `commonSubexprsKeys = [Dependencie_1, Dependencie_2, Dependencie_3, ...]`
    // >> `commonSubexprs = [epsilon - epsilon_vp, E . Dependencie_1, S . Dependencie_2, ...]`

    // Schleife über alle Substitutionen
    for(int i = 0, i < commonSubexprs -> size() - 1, i ++){

        // Referenzen für aktuell betrachtete Elemente
        static{ tExpr ref [lhs, rhs, lhsKey, rhsKey] }
        
        // vorderer Eintrag
        lhsKey, lhs << commonSubexprsKeys -> get(i), commonSubexprs -> get(i)

        // Durch Ausdrücke loopen, die potentiell von `lhs` abhängig sind
        for(int j = i + 1, j < commonSubexprs -> size(), j ++){

            // hinterer Eintrag
            rhsKey, rhs << commonSubexprsKeys -> get(j), commonSubexprs -> get(j)

            // Ersetzung von vorderem Eintrag durch zugehöriges Substitutionsobjekt im hinteren Eintrag 
            rhs -> replace(lhs, lhsKey)
        }

        // Cleanup
        if(i == commonSubexprs -> size() - 1){ dref [lhs, rhs, lhsKey, rhsKey] }
    }

    // Anstellen aller Substitutionen im usprünglichen Ausdruck
    for(int i = 0, i < commonSubexprs -> size(), i ++){
    
        expr -> replace(commonSubexprs -> get(i), commonSubexprsKeys -> get(i))
    }

    // Container für Substitutionsobjekte und -terme in Indexnotation
    args [depsKeys, depsVals]

    // Umwandlen der Substitutionsobjekte und -terme in Indexnotation
    for(int i = 0, i < commonSubexprs -> size(), i ++){

        depsKeys -> emplace(toWrappedIDN(commonSubexprsKeys -> get(i)))
        depsVals -> emplace(toWrappedIDN(commonSubexprs -> get(i)))

        // //
        // slog(depsKeys -> get(i), "=>", depsVals -> get(i))
    }

    // Umwandeln des ursprünglichen Ausdrucks mit angestellten Substitutionen in Indexnotation,
    // Generierung des Julia-Skripts mit Angabe der Substitutionen, Schreiben des Julia-Skripts in Datei
    toWrappedIDN(expr) -> toJuliaString(resLabel, depsKeys, depsVals) -> writeToFile(filePath)
}