// ---------------------------------------------------------------------------
//                      Example 0.0.1 recursiveDemo
// ---------------------------------------------------------------------------
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Import/0_0_0_testEnv.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Import/0_0_0_testEnv.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Import/0_0_0_testEnv.bld

fetch script ["0_0_0_testInclude"]

decl main(int [a,b,c]){

    slog("Init Main")
    testFunction()
}

struct tExpr{}

tExpr prevTExpr

fetch backend "tensor"

//
if(calledAs(__MainProc__)){
    
    tExpr m("A", 2)
    slog(m)

    slog(prevTExpr)

    call(string main => "main", args(1,2,3))
}