// ---------------------------------------------------------------------------
//                      Example 0.0.1 recursiveDemo
// ---------------------------------------------------------------------------
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_0_testEnv.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_0_testEnv.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Examples/0_0_0_testEnv.bld

fetch script ["0_0_0_testInclude"]

// Includes
fetch script ["pckg/preDecls", "pckg/functions"]

decl refTest(int ref m){

    logRes(m)
}

decl main(int [a,b,c]){

    slog("Init Main")
    slog("Rueckgabe :", testFunction())

    refTest(1)

    i = 1
    refTest(i)

    logRes(2 * args(1, 3))

    slog("still standin")
}

//
if(calledAs(__MainProc__)){
    
    call(string main => "main", args(1,2,3))
}