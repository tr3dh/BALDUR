// ---------------------------------------------------------------------------
//                              Example 0.0.7
// ---------------------------------------------------------------------------
// Kontext
// Das Beispiel demonstriert die Nutzung des Tensoralgebra-Systems anhand der Naeherung
// der Periodenlaenge eines Pendels per Taylorreihe
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_7_aproximatingPeriodicLenghtLinearPendulum.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_7_aproximatingPeriodicLenghtLinearPendulum.bld
//
// Für Release
// - $ make exec BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_7_aproximatingPeriodicLenghtLinearPendulum.bld
// - $ make launch BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_7_aproximatingPeriodicLenghtLinearPendulum.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Examples/0_0_7_aproximatingPeriodicLenghtLinearPendulum.bld

// ! TODO :
// * rein numerische Gaußquadratur für Vergleich
// * Annäherung der symbolischen Quadratur und der Reihendarstellung (Vergleich Ergbenisse, Rechenzeiten, etc.)
// * Ableitungen der Reihendarstellung       

// Includes
fetch backend ["tensor"]
fetch script ["pckg/preDecls", "pckg/functions"]

//
g_terminateAfterAssertionFailed = true

//
string [examplePrefix, exampleChapter, exampleTitle] = "0_0_7", "x", "Pendulum"

//
emplaceExtendedSimplifications()
setGenerateExportDebugCall(true)

//
decl tExprScalar(string ref label){ return [tExpr(label, 0)] }

//
decl tExprScalars(args labels){

    args prms

    for(int i = 0, i < labels -> size(), i++){

        prms -> emplace(tExprScalar(labels[i]))
    }

    return [prms]
}

decl printArgs(args prms){
    slog(...prms)
}

//
decl evaluateExample(){

    // Container zur Vereinheitlichung der Beispiele
    tExpr ref result
    string tResultLabel
    
    // Die exakte Gleichung für die Periode des Pendels kann über das eliptische
    // Integral erster Ordnung K(...) geschrieben werden als
    //
    //      T = 4 sqrt(l / g) * K (sin^2 theta0/2)                              [https://arxiv.org/pdf/1007.4026]
    //
    // Das eliptische Integral erster Ordnung ist dabei
    //
    //      K(m) = int_0^(pi/2) du / sqrt(1 - m sin^2 u)                        [https://arxiv.org/pdf/2212.05694v3]
    //
    // und kann über die Summe
    // 
    //      K(m) = (PI / 2) * sum_j [ (2j - 1)!! / 2j!! ]^2 m^j                 [https://arxiv.org/pdf/2212.05694v3]
    //
    // approximiert werden. Der Sinusterm kann dabei umformuliert werden zu
    //
    //      sin^2 theta_0/2 = (1 - cos theta_0) / 2                             [https://arxiv.org/pdf/1502.06628]
    //
    // Der Cosinus-Term kann über eine Taylorreihe mit der Ordnung n entwickelt werden als.
    //
    //      cos theta_0 = sum_m [(-1)^m / (2m)!] * theta_0 ^ 2m                 [https://wumbo.net/examples/derive-cosine-taylor-series/]

    //
    int [KSeriesOrder, cosSeriesOrder] = 10, 10

    //
    tExpr[L, g, theta_0] = ...tExprScalars("L", "g", "theta_0")

    //
    tExpr cosTaylor

    //
    for(int order = 0, order < cosSeriesOrder, order ++){
            
        cosTaylor += wrpSimplified( \
            ((-1) ^ order) * (theta_0 ^ (2 * order)) / factorial(2 * order))
    } \
    defer{ wrpSimplify((cosTaylor)) }

    //
    tExpr m = (1 - cosTaylor) / 2
    wrpSimplify(m)

    //
    tExpr K, mn = tExpr(), tExprScalar("kn")

    //
    for(int order = 0, order < KSeriesOrder, order ++){
            
        K += wrpSimplified( \
            (PI / 2) * [double(ffactorial(2 * order - 1)) / double(ffactorial(2 * order))]^2 * mn ^ (order))
    } \
    defer{ wrpSimplify(K) }

    //
    K -> replace(mn, m)

    //
    tExpr T = 4 * sqrt(L / g) * K

    // Ausdruck : T(L, g, theta_0)
    T -> replace(L, tExpr(0.5))
    T -> replace(g, tExpr(9.81))
    T -> replace(theta_0, tExpr(PI / 2))

    //
    slog("T(L = 0.5, g = 9.81, theta_0 = PI/2) :", rebuild(T))

    // Abgleich mit Quadratur
    // 
    // Das eliptische Integral (Integration über den Winkel Phi)
    //      K(m) = int_0^(pi/2) du / sqrt(1 - m sin^2 u)
    //
    // Damit ist
    //      K(m) = int_0^(pi/2) dPhi / sqrt(1 - m sin^2 Phi)
    //
    // Per Quadratur
    //      K(m) = sum [ phiStep / sqrt(1 - m sin^2 Phi) ] = phiStep * sum_Phi [ 1 / sqrt(1 - m sin^2 Phi) ]
    //
    // wird hier numerisch ausgewertet um einen Referenzwert zu generieren

    // Integrationsgrenzen
    double [theta0Lower, theta0Upper] = 0.0, (PI / 2.0)

    // Amplitude theta_0, fuer die die Periode berechnet wird
    double theta0_amplitude = PI / 2.0

    //
    int N = 2000
    double h = (theta0Upper - theta0Lower) / double(N)
    tExpr KQuad

    // m als reine Zahl, unabhaengig vom symbolischen theta_0 oben im Skript
    tExpr mQuad = sin(theta_0 / 2) ^ 2
    double phiMid                           // aktuelle Stützstelle

    //
    for(int i = 0, i < N, i++){

        phiMid = theta0Lower + h * (double(i) + 0.5)
        KQuad += 1 / sqrt(1.0 - mQuad * (sin(phiMid)^2))
    } \
    defer{ KQuad *= h }

    //
    tExpr TQuad = 4.0 * sqrt(L / g) * KQuad

    // Ausdruck : T(L, g, theta_0)
    TQuad -> replace(L, tExpr(0.5))
    TQuad -> replace(g, tExpr(9.81))
    TQuad -> replace(theta_0, tExpr(PI / 2))

    //
    slog("TQUAD(L = 0.5, g = 9.81, theta_0 = PI/2) :", rebuild(TQuad))

    //
    slog("* Example evaluated")
}

//
decl main(){

    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    double startTime = now()
    callOnExtendedStack("evaluateExample", 1500, args())

    logSeparator()
    slog("Ausfuehrungszeit des Beispiels : ", now() - startTime, "s")
    logSeparator()
    
    return 0
}

// Main Guard
if(calledAs(__MainProc__)){ return [main()] }