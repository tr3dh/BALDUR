// ---------------------------------------------------------------------------
//                              Example 0.0.5
// ---------------------------------------------------------------------------
// Kontext
// Das Beispiel zeigt die Verwendung der im Rahmen der 'pckg'-Umgebung implementierten Funktionen
// 'stdGenerateJuliaString' und 'cssGenerateJuliaString', die den Standardexport und den Export
// inklusive automatischer Erkennung, Zählung und Substitution mehrfach im algebraischen Exportausdruck
// vorkommender Teilausdrücke implementieren
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_6_tExprTensor.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_6_tExprTensor.bld
//
// Für Release
// - $ make exec BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_6_tExprTensor.bld
// - $ make launch BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_6_tExprTensor.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Examples/0_0_6_tExprTensor.bld

// Includes
fetch backend ["tensor"]
fetch script ["pckg/preDecls", "pckg/functions"]

//
string [examplePrefix, exampleChapter, exampleTitle] = "0_0_6", "x", "Exploiting Baldurs Posibillities"
int dimension = 3
int nVoigtComps = getNumOfVoigtComponents(dimension)

decl tVoigtCompsUniTensor(string ref label, int order){

    requires {nVoigtComps > -1} "Invalide Anzahl an Komponenten der Voigt Notation"
    return [ <- tUniExpr(label, order, nVoigtComps)]
}

//
decl exp(tExpr ref expr){ return [<- exp(expr, orderTSM)] }

struct tExprTensor{

    int order
    args components, dimensions

    decl construct(args dimensionsIn){

        // Uebertrag
        dimensions = dimensionsIn

        order = dimensions -> size()
        
        for(int i = 0, i < product(dimensions), i++){

            components -> emplace(tExpr())
        }
    }

    decl get(args indices){

        requires {indices -> size() == order} "Getter bekommt ungueltige Indizes uebergeben"
        requires {nIf(indices... < dimensions...)} "Indizes sind inkosistent mit Dimensionen"

        int [index, stride] = 0, 1
  
        for(i = order - 1, i > -1, i--){

            index += stride * indices -> get(i)
            stride *= dimensions -> get(i)
        }

        requires {index < components -> size()} "Ungültiger Projizierter Index"
        return [<< [components -> get(index)]]
    }
}

decl tExprTensor(args dimensionsIn){

    //
    tExprTensor res
    res -> construct(dimensionsIn)

    return [<- res]
}

//
decl evaluateExample(){

    // Container zur Vereinheitlichung der Beispiele
    tExpr ref result
    string tResultLabel

    //
    tExprTensor res(3,3,3)
    res -> get(1,2,2) = tExpr("EintragA", 2, args(3) * 2)

    slog(res[1,2,2])

    //
    slog("* Example evaluated")
}

//
decl main(){

    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    double startTime = now()
    callOnExtendedStack("evaluateExample", 1500, args())

    logSeparator()
    slog("Ausfuehrungszeit des Beispiels : ", now() - startTime, "s")
    logSeparator()
    
    return 0
}

// Main Guard
if(calledAs(__MainProc__)){ return [main()] }