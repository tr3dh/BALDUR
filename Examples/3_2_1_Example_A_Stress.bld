// ---------------------------------------------------------------------------
//                              Example 3.2.1 A
// ---------------------------------------------------------------------------
// Diese Datei enthält die Rekonstruktion eines Beispiels aus der Dissertation
// "Uncertainty quantification for inelastic materials and structures: Time-separated stochastic mechanics"
// von Hedrik Geisler, 2025
// Kapitel : 3.2.1, Example A : TSM - Modelling Stress, S.34 ff
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Examples/3_2_1_Example_A_Stress.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Examples/3_2_1_Example_A_Stress.bld
//
// Für Release
// - $ make exec BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/3_2_1_Example_A_Stress.bld
// - $ make launch BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/3_2_1_Example_A_Stress.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Examples/3_2_1_Example_A_Stress.bld

//
g_emplaceExtendedSimplifications = true

// Includes
fetch backend ["tensor"]
fetch script ["pckg/preDecls", "pckg/functions"]

//
string [examplePrefix, exampleChapter, exampleTitle] = "A", "3.2.1", "TSM - Modelling Stress"
int [orderTSM, dimension] = 1, 2

int nVoigtComps = getNumOfVoigtComponents(dimension)

decl tVoigtCompsUniTensor(string ref label, int order){

    requires {nVoigtComps > -1} "Invalide Anzahl an Komponenten der Voigt Notation"
    return [ <- tUniExpr(label, order, nVoigtComps)]
}

//
decl exp(tExpr ref expr){ return [<- exp(expr, orderTSM)] }

//
decl evaluateExample(){

    //
    slog("* Skript wird fuer TSM", orderTSM, "ter Stufe in", dimension, "D ausgefuehrt")

    // Container zur Vereinheitlichung der Beispiele
    tExpr ref result
    string tResultLabel

    //
    epsilon, epsilonv = tVoigtCompsUniTensor("epsilon", 1), tVoigtCompsUniTensor("epsilonv", 1)
    ETSM = [E0 => tVoigtCompsUniTensor("E0", 2)] + [D => tVoigtCompsUniTensor("D", 2)]

    //
    epsilonvTSM = emplcXtNodesTaylorSeries(epsilonv, D, orderTSM)
    sigma = ETSM . (epsilon - epsilonvTSM)
    sigmaTSM = emplcDiffsTaylorSeries(sigma, D, orderTSM)

    //
    result << sigmaTSM
    tResultLabel = "sigmaTSM"

    //
    wrpSimplify(result)

    //
    slog("* Ergebnis in Ausdrucksnotation mit", result->getNumOfNodes(), "Nodes und", result->getNumOfExternalNodes(), "external Nodes")

    //
    void tIDNResult = toIdn(result)
    slog("* Ergebnis Indexnotation mit", tIDNResult->getNumOfNodes(), "Nodes und", tIDNResult->getNumOfExternalNodes(), "external Nodes")

    //
    slog("* Writing Tangents", tResultLabel, "Index Notation to jl File ...")

    //
    tIDNResult = toWrappedIDN(result)
    tIDNResult->toJuliaString(tResultLabel)->writeToFile("Examples/juliaScripts/" + exampleChapter + "_" + \
        examplePrefix + "_" +  tResultLabel + ".jl")

    //
    slog("* Example evaluated, Resultexpression with", result -> getNumOfNodes(), "Nodes")
}

setGenerateExportHelpers(false)
setGenerateExportDebugCall(true)

//
decl main(){

    a, b, c, d = ...tExprScalars("a", "b", "c", "d")

    Aa, Bb, Cc = ...tUniExprs(args("Aa", "Bb", "Cc"), 2, 3)

    tExpr expr = nSqrt(a + b + trace(Cc), c + d)
    slog(expr)

    tIdn idnExpr = toIdn(expr)
    slog(idnExpr)

    string script = "include(\"helpers.jl\")\n" + idnExpr -> toJuliaString("evalExpr")
    slog(script)

    script -> writeToFile("Examples/juliaScripts/evalExpr.jl")
    generateJuliaHelpers() -> writeToFile("Examples/juliaScripts/helpers.jl")

    script = idnExpr -> toFortranString("evalExpr")
    script -> writeToFile("Examples/fortranScripts/evalExpr.f")

    generateFortranHelpers() -> writeToFile("Examples/fortranScripts/helpers.f")

    // string script = stdGenerateJuliaString(idnExpr, "evalExpr", "Examples/juliaScripts/evalExpr.jl")

    return

    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    double startTime = now()
    callOnExtendedStack("evaluateExample", 1500, args())

    logSeparator()
    slog("Ausfuehrungszeit des Beispiels : ", now() - startTime, "s")
    logSeparator()

    return 0
}

// Main Guard
if(calledAs(__MainProc__)){ return [main()] }