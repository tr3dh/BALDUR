// ---------------------------------------------------------------------------
//                              Example 0.0.5
// ---------------------------------------------------------------------------
// Kontext
// Das Beispiel zeigt das Ermitteln der vektoriellen Spannung eines linear elastischen Materials als symbolische Ableitung der freien
// Helmholtz-Energiedichte Psi nach der Dehnung epsilon.
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_4_FreeEnergieDensityLinElast.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_4_FreeEnergieDensityLinElast.bld
//
// Für Release
// - $ make exec BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_4_FreeEnergieDensityLinElast.bld
// - $ make launch BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Examples/0_0_4_FreeEnergieDensityLinElast.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Examples/0_0_4_FreeEnergieDensityLinElast.bld

fetch backend ["tensor"]                        
fetch script ["pckg/preDecls", "pckg/functions"]

// Ableitung der freien Energie Dichte eines lin. elastischen Materials nach der Dehnung
Psi = [epsilon => tExpr("epsilon", 2, args(3) * 2)] : tExpr("E", 4, args(3) * 4) : epsilon
sigma = diff(Psi, epsilon)
toIDN(wrpSimplified(sigma)) -> toJuliaString("evalSigma") -> writeToFile("Examples/juliaScripts/evalSigma.jl")

// Ableitung der freien Energie Dichte eines lin. elastischen Materials nach der Dehnung in Voigt-Notation
Psi = [epsilon => tExpr("epsilon", 1, args(6) * 1)] . tExpr("E", 2, args(6) * 2) . epsilon
sigma = diff(Psi, epsilon)
toIDN(wrpSimplified(sigma)) -> toJuliaString("evalSigmaVoigt") -> writeToFile("Examples/juliaScripts/evalSigmaVoigt.jl")