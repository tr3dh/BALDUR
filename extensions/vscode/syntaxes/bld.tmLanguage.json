{
  "scopeName": "source.bld",
  "patterns": [
    {
      "name": "comment.line.double-slash.bld",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.bld",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "keyword.control.bld",
      "match": "\\b(if|xIf|rIf|nIf|else|requires|assert|fetch|script|backend|decl|for|while|return|break|continue|static|struct|ref|this)\\b"
    },
    {
      "name": "keyword.type",
      "match": "\\b(void|bool|int|double|string|args)\\b"
    },
    {
      "name": "keyword.const.bld",
      "match": "\\b(true|false|nullArgs)\\b"
    },
    {
      "name": "constant.numeric.bld",
      "match": "\\b[0-9]+\\b"
    },
    {
      "name": "variable.other.bld",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  ]
}