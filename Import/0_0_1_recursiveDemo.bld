// ---------------------------------------------------------------------------
//                      Example 0.0.1 recursiveDemo
// ---------------------------------------------------------------------------
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Import/0_0_1_recursiveDemo.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Import/0_0_1_recursiveDemo.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Import/0_0_1_recursiveDemo.bld

// Includes
fetch script ["pckg/preDecls", "pckg/functions"]

//
string [examplePrefix, exampleChapter, exampleTitle] = "0", "0.0.1", "Recursive Demo"

//
int [g_fibonacciCalls, g_factorialCalls]

decl factorial(int ref member){
    
    g_factorialCalls++
    if(member == 0 || member == 1){ 
        return 1 
    }
    return [member * factorial(member - 1)]
}

decl fibonacci(int ref member){
    
    g_fibonacciCalls++
    if(member <= 1){ 
        return member 
    }
    return [fibonacci(member - 1) + fibonacci(member - 2)]
}

decl runRecursiveDemo(){

    // Fakultäten
    slog(" ")
    for([int [i, numFactorial] = 0,10], i < numFactorial, i++){
        slog("Factorial(", i, ") =", factorial(i))
    }

    // Fibonacci
    slog(" ")
    for([int [i, numFibonacci] = 0,20], i < numFibonacci, i++){
        slog("Fibonacci[", i, "] :", fibonacci(i))
    }

    // Log der Funktionsaufrufe
    slog(" ")
    slog("factorial called :", g_factorialCalls, "times")
    slog("fibonacci called :", g_fibonacciCalls, "times")
}

//
decl main(){

    // Check Registers

    // logTypeRegister()
    // logNullRefs()
    // logFunctionRegister()
    // logDiffTemplates(); logSeparator()
    // logSimplifications(); logSeparator()

    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    //
    runRecursiveDemo()

    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}