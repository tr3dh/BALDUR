// ---------------------------------------------------------------------------
//                              Example 3.2.1 D
// ---------------------------------------------------------------------------
// Diese Datei enthält die Rekonstruktion eines Beispiels aus der Dissertation
// "Uncertainty quantification for inelastic materials and structures: Time-separated stochastic mechanics"
// von Hedrik Geisler, 2025
// Kapitel : 3.2.1, Example D : TSM - Modelling of the evolution equation of viscoelasticity with analytical solution, S.38 ff
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/BaldurTestEnv SCRIPT=Import/3_2_1_Example_D_ve_evolutionequation.bld
// - Ohne Interpreter build: $ make exec TARGET=build/BaldurTestEnv SCRIPT=Import/3_2_1_Example_D_ve_evolutionequation.bld
//
// Für Release
// - $ make exec BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Import/3_2_1_Example_D_ve_evolutionequation.bld
// - $ make launch BUILD_MODE=NDEBUG TARGET=build/BaldurTestEnv SCRIPT=Import/3_2_1_Example_D_ve_evolutionequation.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/Baldur_d execute Import/3_2_1_Example_D_ve_evolutionequation.bld

//
fetch backend ["tensor"]

// Steuert welche Konvention beim Einlagern der Standardtemplates verwendet wird
bool g_emplaceTemplatesUnwrapped = false
setUnwrapOperands(g_emplaceTemplatesUnwrapped)

// Flag für das Setzen erweiterter Simplifizierungsregeln
// bool g_emplaceExtendedSimplifications = true

// Includes
fetch script ["pckg/preDecls", "pckg/functions"]

//
string [examplePrefix, exampleChapter, exampleTitle] = "D", "3.2.1", "Modelling of the evolution equation of viscoelasticity with analytical solution"
int [orderTSM, dimension] = 3, 2

//
// setUnwrapOperands(false)
// disableDiffTemplateDefaults()

decl exp(tExpr ref expr){

    return [<-exp(expr, orderTSM)]
}

//
decl evaluateExample(int orderTSM, int dimension){

    //
    tExpr ref result
    string tResultLabel
    int nVoigtComps = getNumOfVoigtComponents(dimension)

    //
    tExpr [epsilon, u, deltaEpsilon, deltaU] = tExpr("epsilon", 1, args(nVoigtComps)), tExpr("u", 1, args(nVoigtComps)), \
                                                tExpr("deltaEpsilon", 1, args(nVoigtComps)), tExpr("deltaU", 1, args(nVoigtComps))

    void [E0, D, Xi] = tExpr("E0", 2, args(nVoigtComps, nVoigtComps)), tExpr("D", 2, args(nVoigtComps, nVoigtComps)), tExpr("Xi", 2, args(nVoigtComps, nVoigtComps))
    tExpr [sigma, E] = (tExpr("sigma", 1, args(nVoigtComps)), E0 + Xi)
    tExpr [eta, S] = tExpr("eta", 0), tExpr("S", 2, args(nVoigtComps, nVoigtComps))
    tExpr epsilonv = tExpr("epsilonv", 1, args(nVoigtComps))
    tExpr [t, s] = tExpr("t", 0), tExpr("s", 0)

    //
    tExpr epsilonv_dot_t = (inverse(eta) * S) . E . (epsilon - epsilonv)
    tExpr epsilonv_t = (inverse(eta) * S) . E . exp((inverse(eta) * S) . E) . epsilon 

    tExpr epsilonv_TSM_t = taylorSeries(epsilonv_t, Xi, orderTSM)

    //
    result << epsilonv_TSM_t
    tResultLabel = "epsilonv_TSM_t"

    // unter Umständen muss der Ausdruck hier nochmal gewrapped werden damit eine Übereinstimmung mit den gängigen Simplify Templates angewendet werden kann
    // Diese Vereinfachungen / Vereinfachungstemplates können nicht für eine beliebige anzahl an operanden definiert werden. Deshalb empfiehlt es sich sie nur für konkret zwei
    // Operanden zu definieren und wenn nötig die Ausdrucksstruktur in diese Form zu bringen

    //
    wrpSimplify(result)

    //
    slog("Skript wird fuer TSM", orderTSM, "ter Stufe in", dimension, "D ausgefuehrt")
    logSeparator()

    //
    slog("Ergebnis in Ausdrucksnotation mit", result->getNumOfNodes(), "Nodes und", result->getNumOfExternalNodes(), "external Nodes")
    // logSeparator()

    //
    slog(result)
    logSeparator()

    //
    void tIDNResult = toIDN(result)
    slog("Ergebnis Indexnotation mit", tIDNResult->getNumOfNodes(), "Nodes und", tIDNResult->getNumOfExternalNodes(), "external Nodes")
    // logSeparator()

    //
    slog(tIDNResult)
    logSeparator()

    //
    slog("Writing Wrapped IDN to jl File ...")

    //
    tIDNResult = toWrappedIDN(result)
    tIDNResult->toJuliaString(tResultLabel)->writeToFile("Import/juliaScripts/" + exampleChapter + "_" + \
        examplePrefix + "_autodiff_wrapped" + tResultLabel + ".jl")

    //
    slog("Example evaluated")
}

//
decl main(){

    // Check Registers

    // logTypeRegister()
    // logNullRefs()
    // logFunctionRegister()
    // logDiffTemplates(); logSeparator()
    // logSimplifications(); logSeparator()

    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    //
    evaluateExample(orderTSM, dimension)

    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}