// Diese Datei enthält die Rekonstruktion eines Beispiels aus der Dissertation
// "Uncertainty quantification for inelastic materials and structures: Time-separated stochastic mechanics"
// von Hedrik Geisler, 2025
// Kapitel : 3.2.1, Example C : TSM - Modelling Steady State balance of linear momentum, S.34 ff
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/ProcTestEnv SCRIPT=../Import/3_2_1_Example_C_SteadyState_Balance.bld
// - Ohne Interpreter build: $ make exec TARGET=build/ProcTestEnv SCRIPT=../Import/3_2_1_Example_C_SteadyState_Balance.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/ProcLang_d execute Import/3_2_1_Example_C_SteadyState_Balance.bld

// Includes
fetch script ["pckg/preDecls"]

//
string [examplePrefix, exampleChapter, exampleTitle] = "C", "3.2.1", "TSM - Modelling Steady State balance of linear momentum"

int orderTSM = 15

//
// setUnwrapOperands(true)

//
decl evaluateExample(int orderTSM){

    //
    tExpr ref result

    //
    void [E0, Xi] = tExpr("E0", 2), tExpr("Xi", 2)
    void [ETSM] = E + D

    tExpr [BMat, NMat] = tExpr("BMat", 2), tExpr("NMat", 2)
    tExpr DMat = tExpr("DMat", 2)
    tExpr bstar = tExpr("bstar", 1)

    //
    setDiffTemplate(DMat, tmplA, zeros(DMat \(x) tmplA))

    //
    tExpr F = DMat . sigma - bstar
    tExpr [uTSM, epsilonTSM] = tExprTaylorSeries(u, Xi, orderTSM), tExprTaylorSeries(epsilon, Xi, orderTSM)

    //
    tExpr sigmaTSM = ETSM . (BMat . u)
    tExpr FTSM = F->getReplaced(sigma, sigmaTSM)

    //
    tExpr [dFdXi, d2Fd2Xi]  = diff(FTSM, Xi), diff(FTSM, Xi, 2)

    //
    result << d2Fd2Xi

    //
    slog("Skript wird fuer TSM", orderTSM, "ter Stufe ausgefuehrt")

    //
    slog("Ergebnis in Ausdrucksnotation mit", result->getNumOfNodes(), "Nodes")
    // logSeparator()

    //
    // slog(sigmaTSM_t)
    // logSeparator()

    slog("Ergebnis Indexnotation mit", toIDN(result)->getNumOfNodes(), "Nodes")
    logSeparator()

    //
    // slog(toIDN(sigmaTSM_t))
    // logSeparator()
}

//
decl main(){

    // Check Registers

    // logTypeRegister()
    // logNullRefs()
    // logDiffTemplates(); logSeparator()
    // logSimplifications(); logSeparator()

    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    //
    evaluateExample(orderTSM)
    
    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}