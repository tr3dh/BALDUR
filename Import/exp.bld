// Includes
fetch script ["pckg/preDecls", "pckg/Vector3"]
fetch script ["pckg/recursiveDemo"]

// Assert Uniforms >> sicherstellen dass bestimmte Referenzen vom Programm ans Skript übergeben werden
requires string uniform ExecMode
requires [ExecMode == "DEBUG"] "..."

//
decl handleArgs(args prms){
    
    //
    void baseMember = prms->get(0)

    //
    for(int i = 1, i < prms->size(), i++){

        baseMember += prms->get(i)
    }

    //
    return baseMember
}

struct testStruct{

    int ref [a,b]
}

decl testStruct(int ref[aIn, bIn]){
    
    testStruct str
    str->[a, b] << aIn, bIn

    return [<-str]
}

decl test(){

    int ref expRef 
    void prms
    void vec

    slog("Scope Init")

    int ref [aref, bref, cref]

    int i = 0
    int j = 0

    while(j < 3){

        while(i < 10){

            if(i == 5){

                int [a, b, c] = 0,0,0 
                aref, bref, cref << a, a, a
                vec = testStruct(a,a)
            }

            i++
        }

        j++
    }

    slog("Scope Löschung")

    slog(aref, bref, cref)
    slog(vec)
}

//
decl main(){
    
    log("Programm '", __script__, "' mit args [", __args__, "] gestartet")
    log(" ")

    logDiffTemplates()
    logSimplifications()

    void [scalar, A, B] = tExpr("scalar", 0), tExpr("A", 3), tExpr("B", 3)

    slog(diff(A * 0.9, B))

    void tmp = 0.5 * (L' + L)
    simplify(tmp)
    slog(tmp)

    test()

    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}