// Includes
fetch script ["pckg/preDecls", "pckg/Vector3"]
fetch script ["pckg/recursiveDemo"]

// Assert Uniforms >> sicherstellen dass bestimmte Referenzen vom Programm ans Skript übergeben werden
requires string uniform ExecMode
assert(ExecMode == "DEBUG", "...")

//
decl main(){
    
    // // Header
    // logSeparator()
    // log("Programm '", __script__, "' mit args [", __args__, "] gestartet")
    // logSeparator()

    // Check Registers

    // logTypeRegister()
    // logNullRefs()
    logDiffTemplates(); logSeparator()
    logSimplifications(); logSeparator()

    // variablen
    void [E0, D] = tExpr("E0", 2), tExpr("D", 2)
    void [x, xi, xi0] = tExpr("x", 0), tExpr("xi", 0), tExpr("xi0", 0)

    //
    // void [E_TSM] = (1 + xi) * E0
    void [E_TSM] = E + D
    void [sigma0, sigmaFl] = (E0 . epsilon, D . epsilon)
    void [sigma] = E0 . epsilon + D . epsilon

    //
    // void [sigma_TSM] = sigma0 + sigmaFl

    //
    void tmp = tExpr(0.4) * tExpr(0.3)
    simplify(tmp)
    slog(tmp)

    tmp = E + D
    slog(diff(E + D, D))

    // logSeparator()
    // slog(tExpr(0.4) == CnstTmplA)
    // slog(tExprInstcTmpl("Identity") == tExpr("Identity", 4))

    //
    // void [u_TSM, epsilon_TSM, sigma_TSM] = (u + xi * diff(u, t), epsilon + xi * diff(epsilon, t), sigma + xi * diff(sigma, t)) 
    // auch möglich über taylorSeries(u, xi, xi0, 2)

    //
    // slog(u_TSM)

    // logSeparator()
    // log("Shutting Down")
    // logSeparator()

    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}