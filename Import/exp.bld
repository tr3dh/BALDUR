// Includes
fetch script ["pckg/preDecls", "pckg/Vector3"]
fetch script ["pckg/recursiveDemo"]

// Assert Uniforms >> sicherstellen dass bestimmte Referenzen vom Programm ans Skript übergeben werden
requires string uniform ExecMode
requires [ExecMode == "DEBUG"] "..."

//
decl main(){
    
    logDiffTemplates()
    logSimplifications()

    void [scalar, A, B] = tExpr("scalar", 0), tExpr("A", 3), tExpr("B", 2)

    slog(unwrap(diff(scalar * scalar * scalar * x, X)))

    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}