// ---------------------------------------------------------------------------
//                              Example 3.2.2 A
// ---------------------------------------------------------------------------
// Diese Datei enthält die Rekonstruktion eines Beispiels aus der Dissertation
// "Uncertainty quantification for inelastic materials and structures: Time-separated stochastic mechanics"
// von Hedrik Geisler, 2025
// Kapitel : 3.2.1, Example D : TSM - Modelling of the evolution equation of viscoelasticity, S.44 ff
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/ProcTestEnv SCRIPT=../Import/3_2_2_Example_A_ve_evolutionequation.bld
// - Ohne Interpreter build: $ make exec TARGET=build/ProcTestEnv SCRIPT=../Import/3_2_2_Example_A_ve_evolutionequation.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/ProcLang_d execute Import/3_2_2_Example_A_ve_evolutionequation.bld

// Includes
fetch script ["pckg/preDecls", "pckg/functions"]

//
string [examplePrefix, exampleChapter, exampleTitle] = "A", "3.2.2", "Modelling of the evolution equation of viscoelasticity"
int [orderTSM, dimension] = 2, 2
tExpr nullRef

//
// setUnwrapOperands(false)
// disableDiffTemplateDefaults()

decl exp(tExpr ref expr){

    return [<-exp(expr, orderTSM)]
}

//
decl evaluateExample(int orderTSM, int dimension){

    //
    tExpr ref result
    string tResultLabel
    tIdn tIDNResult

    int nVoigtComps = getNumOfVoigtComponents(dimension)

    //
    tExpr [epsilon, u, deltaEpsilon, deltaU] = tExpr("epsilon", 1, args(nVoigtComps)), tExpr("u", 1, args(nVoigtComps)), \
                                                tExpr("deltaEpsilon", 1, args(nVoigtComps)), tExpr("deltaU", 1, args(nVoigtComps))

    void [E0, D, Xi] = tExpr("E0", 2, args(nVoigtComps, nVoigtComps)), tExpr("D", 2, args(nVoigtComps, nVoigtComps)), tExpr("Xi", 2, args(nVoigtComps, nVoigtComps))
    tExpr [sigma, E] = (tExpr("sigma", 1, args(nVoigtComps)), E0 + Xi)
    tExpr [eta, S] = tExpr("eta", 0), tExpr("S", 2, args(nVoigtComps, nVoigtComps))
    tExpr epsilonv = tExpr("epsilonv", 1, args(nVoigtComps))
    tExpr [t, s] = tExpr("t", 0), tExpr("s", 0)

    //
    requireDiffs(orderTSM ^ 2, epsilon, t, "epsilon", "t")
    requireDiffs(orderTSM ^ 2, epsilonv, t, "epsilonv", "t")
    requireDiffs(orderTSM ^ 2, epsilonv, Xi)
    requireDiffs(orderTSM ^ 2, D, Xi)

    // Evolutionsgleichung der internen Variable
    tExpr epsilonv_dot = (inverse(eta) * S) . E . (epsilon - epsilonv)
    
    // Approximation der internen Variable durch Taylorreihe
    tExpr epsilonv_TSM = taylorSeries(epsilonv, Xi, orderTSM, false)

    // Einsetzen der Approximation der internen Variable in Evolutionsgleichung
    tExpr epsilonv_dot_TSM <+ epsilonv_dot
    epsilonv_dot_TSM->replace(epsilonv, epsilonv_TSM)

    // Die erweiterte Evolutionsgleichung 'epsilonv_TSM_dot_t' wird gleichgesetzt mit der zeitlichen
    // Ableitung der Approximation der internen Variable
    // Dadurch ergibt sich die Gleichung (3.75) [Geisler]
    //
    // epsilonv_dot(0) + epsilonv_dot(1) : Xi + ... = eta^-1 S (E0 + Xi) (epsilonv - epsilonv0 - epsilonv1 : Xi - ...)
    // 
    // Die i-te Tangente auf der linken Seite kann damit isoliert werden, indem die Gleichung i mal abgeleitet wird und für Xi 0 eingesetzt 

    // Ermitteln der Tangenten
    for(int order = 0, order < orderTSM + 1, order++){

        static{

            // res container
            tExpr tangent
            result << tangent
        }

        // Tangente i mal ableiten und Xi mit null substituieren
        tangent = diff(epsilonv_dot_TSM, Xi, order)
        tangent->replace(Xi, zeros(Xi))

        // Tangente abschließend simplifizieren
        wrpSimplify(tangent)

        // Tangente in Julia Skript schreiben
        tResultLabel = "epsilonv_dot_" + string(order)
        
        //
        log("Writing Tangents '", tResultLabel, "' wrapped IDN Representation to jl File ...")

        //
        tIDNResult = toWrappedIDN(result)
        tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + exampleChapter + "_" + \
            examplePrefix + "_wrapped_tangent_" + tResultLabel + ".jl")

        // DREF
        if(order == orderTSM){ result << nullRef }
    }

    //
    logSeparator()

    //
    slog("Example evaluated")
}

//
decl main(){

    // Check Registers

    // logTypeRegister()
    // logNullRefs()
    // logFunctionRegister()
    // logDiffTemplates(); logSeparator()
    // logSimplifications(); logSeparator()

    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    //
    evaluateExample(orderTSM, dimension)

    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}