// ---------------------------------------------------------------------------
//                              Example 3.2.2 B
// ---------------------------------------------------------------------------
// Diese Datei enthält die Rekonstruktion eines Beispiels aus der Dissertation
// "Uncertainty quantification for inelastic materials and structures: Time-separated stochastic mechanics"
// von Hedrik Geisler, 2025
// Kapitel : 3.2.1, Example D : TSM - Modelling of the evolution equation of viscoelasticity, S.44 ff
//
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/ProcTestEnv SCRIPT=../Import/3_2_2_Example_C_vp_evolutionequation.bld
// - Ohne Interpreter build: $ make exec TARGET=build/ProcTestEnv SCRIPT=../Import/3_2_2_Example_C_vp_evolutionequation.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/ProcLang_d execute Import/3_2_2_Example_C_vp_evolutionequation.bld

// Includes
fetch backend []
fetch script ["pckg/preDecls", "pckg/functions"]

//
string [examplePrefix, exampleChapter, exampleTitle] = "C", "3.2.2", "Modelling of the evolution equation of elasto-viscoplasticity"
int [orderTSM, dimension] = 2, 3
bool seperateFluctuations = true

//
decl exp(tExpr ref expr){ return [<-exp(expr, orderTSM)] }

//
// disableDiffTemplateDefaults()
setGenerateJLDebugCall(false)

//
decl evaluateExample(int orderTSM, int dimension){

    // !! Wichtig : Ausdrücke die Templates enthalten sollten nicht simplifiziert werden
    // Templates sollen ja andere Ausdrücke repsräsentieren und dass tuen sie auch im Ableich mit den restlichen
    // SimplifizierungsTemplates und Simplifizierungen die Instanzen enthalten 
    // tExpr expDiff
    // for([expDiff = tExpr(); i = 0], i < orderTSM + 1, i++){ expDiff += (1.0/factorial(i)) * diff(tmplA ^ i, tmplB) }
    // setDiffTemplate(exp(tmplA, orderTSM, false), tmplB, expDiff)
    // for([expDiff = tExpr(); i = 0], i < orderTSM + 1, i++){ expDiff += (1.0/factorial(i)) * diff(tmplScalar ^ i, tmplB) }
    // setDiffTemplate(exp(tmplScalar, orderTSM, false), tmplB, expDiff)

    //
    tExpr ref result
    string tResultLabel
    tIdn tIDNResult

    int nVoigtComps = getNumOfVoigtComponents(dimension)

    //
    tExpr [epsilon, u, deltaEpsilon, deltaU] = tExpr("epsilon", 1, args(nVoigtComps)), tExpr("u", 1, args(nVoigtComps)), \
                                                tExpr("deltaEpsilon", 1, args(nVoigtComps)), tExpr("deltaU", 1, args(nVoigtComps))

    //
    void [E0, D, Xi] = tExpr("E0", 2, args(nVoigtComps, nVoigtComps)), tExpr("D", 2, args(nVoigtComps, nVoigtComps)), tExpr("Xi", 2, args(nVoigtComps, nVoigtComps))
    tExpr [E] = E0 + D
    tExpr [eta, S] = tExpr("eta", 0), tExpr("S", 2, args(nVoigtComps, nVoigtComps))
    tExpr [epsilonvp] = tExpr("epsilonvp", 1, args(nVoigtComps))
    tExpr [t, s] = tExpr("t", 0), tExpr("s", 0)

    //
    tExpr [sigma] = E . (epsilon - epsilonvp)
    tExpr [sigmaY0, sigmaYTild] = tExpr("sigmaY", 0), tExpr("sigmaYTild", 0)
    tExpr [sigmaY] = sigmaY0 + sigmaYTild

    // // Für übersichtlichere Behandlung wird die Ausgeschriebene Form der Heaviside Funktion durch das Symbol H ersetzt
    // removeEmplacedDiffTemplate(macaulay(tmplScalar), tmplB)
    // setDiffTemplate(macaulay(tmplScalar), tmplB, tExpr("H", 0) * diff(tmplScalar, tmplB))

    //
    tExpr devSigma = tExpr("devSigma", 1, args(nVoigtComps))
    devSigma = S . E . (epsilon - epsilonvp)

    // Evolutionsgleichung der internen Variable
    tExpr epsilonvp_dot = inverse(eta) * macaulay((frobenius(devSigma) - sigmaY)) * inverse(frobenius(devSigma)) * (devSigma)

    // // anderer Ansatz
    // [tExpr epsilonvp_TSM, args tangents] = taylorSeries(epsilonvp, Xi, orderTSM, false, true)

    //
    tExpr s_epsilonvp_TSM, args s_tangents

    tExpr tangent = epsilonvp->asExternalNode("epsilonvp_0")
    s_tangents->emplace(<+tangent)
    s_epsilonvp_TSM += tangent

    //
    for(int order = 1, order < orderTSM + 1, order++){
        
        //
        static{ tExpr [tmpE, tangentE, tmpY, tangetY] }

        //
        tangentE = diff(epsilonvp, D, order)->asExternalNode("epsilonvp_E_" + string(order))
        tangentY = diff(epsilonvp, sigmaYTild, order)->asExternalNode("epsilonvp_Y_" + string(order))
        s_tangents->emplace(<+tangentE, <+tangetY)

        //
        for((tmpE = (1.0/factorial(order)) * tangentE, int i = 0), i < order, i++){ tmpE := D }
        for((tmpY = (1.0/factorial(order)) * tangentY, int i = 0), i < order, i++){ tmpY *= sigmaYTild }

        // Hier wird x durch konkreten Wert x0 ersetzt
        s_epsilonvp_TSM += wrpSimplified(tmpE)
        s_epsilonvp_TSM += wrpSimplified(tmpY)
    }

    //
    wrpSimplify(s_epsilonvp_TSM)

    // Tangenten für die Spannung

    //
    tExpr sigma_TSM <+ sigma
    sigma_TSM->replace(epsilonvp, s_epsilonvp_TSM)

    slog("Tangente sigma_0")
    logSeparator()

    // Tangente i mal ableiten und D mit null substituieren
    tangent = sigma_TSM
    tangent->replace(D, zeros(D))
    tangent->replace(sigmaYTild, tExpr(0))
    wrpSimplify(tangent)

    //
    // slog(tangent)

    // Tangente in Julia Skript schreiben
    result << tangent
    tResultLabel = "sigma_0"
    log("Writing Tangents '", tResultLabel, "' wrapped IDN Representation to jl File ...")

    //
    tIDNResult = toWrappedIDN(result)
    tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + exampleChapter + "_" + \
        examplePrefix + "_wrapped_tangent_" + tResultLabel + ".jl")

    // Ermitteln der Tangenten
    for(int order = 1, order < orderTSM + 1, order++){

        static{ tExpr [tmpE, tangentE, tmpY, tangetY] }

        // Tangente i mal ableiten und D mit null substituieren
        tangentE = diff(sigma_TSM, D, order)
        tangentE->replace(D, zeros(D))
        tangentE->replace(sigmaYTild, tExpr(0))
        wrpSimplify(tangentE)

        logSeparator()
        slog("Tangente sigma_E_" + string(order))
        // slog(tangentE)

        // Tangente i mal ableiten und sigmaYTild mit null substituieren
        tangentY = diff(sigma_TSM, sigmaYTild, order)
        tangentY->replace(D, zeros(D))
        tangentY->replace(sigmaYTild, tExpr(0))
        wrpSimplify(tangentY)

        logSeparator()
        slog("Tangente sigma_Y_" + string(order))
        // slog(tangentY)
        
        //
        logSeparator()

        // Tangente in Julia Skript schreiben
        result << tangentE
        tResultLabel = "sigma_E_" + string(order)
        log("Writing Tangents '", tResultLabel, "' wrapped IDN Representation to jl File ...")

        //
        tIDNResult = toWrappedIDN(result)
        tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + exampleChapter + "_" + \
            examplePrefix + "_wrapped_tangent_" + tResultLabel + ".jl")

        // Tangente in Julia Skript schreiben
        result << tangentY
        tResultLabel = "sigma_Y_" + string(order)
        log("Writing Tangents '", tResultLabel, "' wrapped IDN Representation to jl File ...")

        //
        tIDNResult = toWrappedIDN(result)
        tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + exampleChapter + "_" + \
            examplePrefix + "_wrapped_tangent_" + tResultLabel + ".jl")

        // DREF vor Schleifenabbruch
        if(order == orderTSM){ dref result }
    }

    //
    devSigma->replace(epsilonvp, s_epsilonvp_TSM)

    // Erweitern der Evolutionsgleichung, ändert hier tatsächlich nichts, nur Platzhalter für nicht subtituierten Fall
    tExpr epsilonvp_dot_TSM <+ epsilonvp_dot
    epsilonvp_dot_TSM->replace(epsilonvp, s_epsilonvp_TSM)
    wrpSimplify(epsilonvp_dot_TSM)

    // Die erweiterte Evolutionsgleichung 'epsilonv_TSM_dot_t' wird gleichgesetzt mit der zeitlichen
    // Ableitung der Approximation der internen Variable
    // Dadurch ergibt sich die Gleichung (3.75) [Geisler]
    //
    // epsilonv_dot(0) + epsilonv_dot(1) : Xi + ... = eta^-1 S (E0 + Xi) (epsilonv - epsilonv0 - epsilonv1 : Xi - ...)
    // 
    // Die i-te Tangente auf der linken Seite kann damit isoliert werden, indem die Gleichung i mal abgeleitet wird und für Xi 0 eingesetzt 

    //
    slog("Gewählter Ansatz für epsilonvp")
    slog(s_epsilonvp_TSM)
    logSeparator()

    slog("Evolutiongleichung")
    slog(epsilonvp_dot)
    logSeparator()

    slog("erweiterte Evolutiongleichung")
    slog(epsilonvp_dot_TSM)
    logSeparator()

    //
    args outputs

    slog("Tangente epsilonvp_0")

    // Tangente i mal ableiten und D mit null substituieren
    tangent <+ epsilonvp_dot_TSM
    tangent->replace(D, zeros(D))
    tangent->replace(sigmaYTild, zeros(sigmaYTild))
    wrpSimplify(tangent)

    //
    // slog(tangent)
    logSeparator()

    // Tangente in Julia Skript schreiben
    result << tangent
    tResultLabel = "epsilonvp_0"
    log("Writing Tangents '", tResultLabel, "' wrapped IDN Representation to jl File ...")

    //
    tIDNResult = toWrappedIDN(result)
    tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + exampleChapter + "_" + \
        examplePrefix + "_wrapped_tangent_" + tResultLabel + ".jl")

    // Ermitteln der Tangenten
    for(int order = 1, order < orderTSM + 1, order++){

        static{ tExpr [tmpE, tangentE, tmpY, tangetY] }

        // Tangente i mal ableiten und D mit null substituieren
        tangentE = diff(epsilonvp_dot_TSM, D, order)
        tangentE->replace(D, zeros(D))
        tangentE->replace(sigmaYTild, tExpr(0))
        wrpSimplify(tangentE)

        logSeparator()
        slog("Tangente epsilonvp_E_" + string(order))
        // slog(tangentE)

        // Tangente i mal ableiten und sigmaYTild mit null substituieren
        tangentY = diff(epsilonvp_dot_TSM, sigmaYTild, order)
        tangentY->replace(D, zeros(D))
        tangentY->replace(sigmaYTild, tExpr(0))
        wrpSimplify(tangentY)

        logSeparator()
        slog("Tangente epsilonvp_Y_" + string(order))
        // slog(tangentY)
        
        //
        outputs->emplace(<+tangentE, <+tangentY)

        //
        logSeparator()

        // Tangente in Julia Skript schreiben
        result << tangentE
        tResultLabel = "epsilonvp_E_" + string(order)
        log("Writing Tangents '", tResultLabel, "' wrapped IDN Representation to jl File ...")

        //
        tIDNResult = toWrappedIDN(result)
        tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + exampleChapter + "_" + \
            examplePrefix + "_wrapped_tangent_" + tResultLabel + ".jl")

        // Tangente in Julia Skript schreiben
        result << tangentY
        tResultLabel = "epsilonvp_Y_" + string(order)
        log("Writing Tangents '", tResultLabel, "' wrapped IDN Representation to jl File ...")

        //
        tIDNResult = toWrappedIDN(result)
        tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + exampleChapter + "_" + \
            examplePrefix + "_wrapped_tangent_" + tResultLabel + ".jl")

        // DREF vor Schleifenabbruch
        if(order == orderTSM){ dref result }
    }

    //
    logSeparator()

    //
    slog("Example evaluated")
}

//
decl main(){

    // // Check Registers
    // logRegisteredBackends()
    // logTypeRegister()
    // logNullRefs()
    // logFunctionRegister()
    // logPresetDiffs()
    // logDiffTemplates()
    // logSimplifications()
    
    //
    logSeparator()
    log("Fuehre Example ", exampleChapter, " ", examplePrefix, " aus : '", exampleTitle, "'")
    logSeparator()

    // Der Interpreter hat standardmäßig ohne Linkerspezifikationen 2MB Stack zur Verfügung.
    // Rekursive Aufrufe verbrauchen sehr schnell Stack-Speicher, da sich das Programm die
    // Return Adresse, Variablen aus lokalen Scopes, etc. für jeden rekursiven Funktionsaufruf
    // im Stack abspeichern muss und den Speicher solange nicht wieder freigeben kann bis der
    // Return stattgefunden hat. Damit wächst der benötigte Speicher im Stack bis zur maximalen
    // Rekursionstiefe mit an. Aus diesen Grund reicht der Standardstack für Tensorausdrücke mit
    // hoher Komplexität häufig nicht mehr aus.
    // Selbst simple, kaum rechenintensive Operationen wie 'wrap', 'unwrap', 'replace', 'rebuild', etc.
    // führen bei Tensorausdrücken mit hoher Komplexität (Check über 'mb->getNumOfNodes()')
    // zum Overflow des 2MB Interpreter Stacks.
    // Zum Umgehen des Problems kann der Interpreter mit der entsprechenden Linkerflag kompiliert
    // werden : 'LDFLAGS += -Wl,--stack,100000000' (nicht laufzeitfähig) oder ein temporärer pthread
    // erzeugt werden (laufzeitfähig), der einen stack der gewünschten Größe allokiert.
    // Dazu dient die im folgenden aufgerufene Funktion.
    // Die Funktion nimmt das Funktionslabel, die Stackgröße in MB und die Funktionsinputs gepackt als
    // Evaluierungsergebnis-Vektor (args) entgegen und erzeugt einen pthread mit einem Stack der übergebenen
    // Größe. In diesem Thread wird die Funktion dann aufgerufen. Nach dem Return der Funktion werden der Stack
    // und der Thread wieder freigegeben.
    callOnExtendedStack("evaluateExample", 1000, args(orderTSM, dimension))

    return 0
}

// Section wird Ausgeführt wenn Skript mit Argument --execute aufgerufen wird
if(calledAs(__MainProc__)){

    return [main()]
}