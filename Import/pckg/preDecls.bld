// Dieser File dient dem Aufstellen und Übergeben spezifischer Ableitungsregeln

// Dummy tExprs für DiffTemplates
// durch -1 ersetzen bei A und B für arbitary
tExpr [a, b, A, B] = tExpr("a", 0), tExpr("b", 0), tExpr("A", -1), tExpr("B", -1)

// Standard TensorExpression Instanzen
tExpr [x, X]  = tExpr("x", 2), tExpr("X", 2)  

tExpr u       = tExpr("u", 1)            // Verschiebung
tExpr epsilon = tExpr("epsilon", 2)      // Dehnung
tExpr sigma   = tExpr("sigma", 2)        // Spannung

tExpr Dev     = tExpr("Dev", 2)          // Deviator
tExpr E       = tExpr("E", 2)            // Elastizitätstensor
tExpr C       = tExpr("C", 2)            // Rechter Cauchy-Green Tensor
tExpr S       = tExpr("S", 2)            // 2. Piola-Kirchhoff Tensor
tExpr F       = tExpr("F", 4)            // Deformationsgradient

//
tExpr [tmplA, tmplB] = tExprTmpl("A", -1), tExprTmpl("B", -1)
tExpr [tmplTensor, tmplScalar, tmplVector, tmplMatrix] = tExprTmpl("a", -1), tExprTmpl("a", 0), tExprTmpl("a", 1), tExprTmpl("a", 2),

// Direkte Ersetzung und Vereinfachung
setDiff(x, X, F)

// template Instanzierungen für Ersetzung durch template Schema

// setDiffTemplate(tmplA', tmplB, diff(tmplA, tmplB)')

setDiffTemplate(tmplScalar * Dev, tmplB, tmplTensor * diff(tmplA, tmplB))

setDiffTemplate(tmplTensor * tmplA, tmplB, tmplTensor * diff(tmplA, tmplB))
setDiffTemplate(tmplScalar * tmplA, tmplB, tmplScalar * diff(tmplA, tmplB))
setDiffTemplate(tmplVector * tmplA, tmplB, tmplVector * diff(tmplA, tmplB))
setDiffTemplate(tmplMatrix * tmplA, tmplB, tmplMatrix * diff(tmplA, tmplB))

// setDiffTemplate(tmplA * tmplTensor, tmplB, tmplTensor * diff(tmplA, tmplB))
setDiffTemplate(tmplA * tmplScalar, tmplB, tmplScalar * diff(tmplA, tmplB))
setDiffTemplate(tmplA * tmplVector, tmplB, tmplVector * diff(tmplA, tmplB))
setDiffTemplate(tmplA * tmplMatrix, tmplB, tmplMatrix * diff(tmplA, tmplB))