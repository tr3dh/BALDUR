// nicht native Vector3 Implementierung
assert(calledAs(__Include__), __script__ + " ist ein Include und eignet sich nicht zur direkten Ausführung")

double [g_a, g_b]

decl logG(){
    slog(g_a, g_b)
}

struct Vector3{
    
    static{
    
        int[a,b]
        
        decl getA(){ return a }
        decl getB(){ return b }

        decl printStatics(){ slog(a, b) }

        decl ping(int x){ logG(); slog("Vector3 ping", x, g_a) }
    }
    
    double[x,y,z]
    
    decl getX(){ return [x] }
    decl getAttribs(){ return[x,y,z] }
    decl mul(double ref db){ combineInplaceByOperator(args([x,y,z]), args(db), "*=", "colmajor") }
    decl print(){ slog(this->getAttribs()) }
}

decl Vector3(double ref [xIn, yIn, zIn]){
    
    Vector3 vec
    vec->[x,y,z] = xIn, yIn, zIn
    
    // move Semanktik >> konstruierter Vector wird in Rückgabe Ergebnis verschoben
    // und kann von dort aus per Zuweisung weiter in eine Variable geschoben werden
    // ohne, dass es zu einem Kopiervorgang kommt
    return [<-vec]
}

decl Vector3(int ref [xIn, yIn, zIn]){
    
    Vector3 vec
    vec->[x,y,z] = double(xIn), double(yIn), double(zIn)
    
    // move Semanktik >> konstruierter Vector wird in Rückgabe Ergebnis verschoben
    // und kann von dort aus per Zuweisung weiter in eine Variable geschoben werden
    // ohne, dass es zu einem Kopiervorgang kommt
    return [<-vec]
}

decl __addAssign__(Vector3 ref [a, b]){
    
    //
    a->[x,y,z] += b->[x,y,z]
}

decl __mulAssign__(Vector3 ref [vec], double ref [db]){ vec->mul(db) }
decl __mulAssign__(Vector3 ref [vec], int ref [db]){ vec->mul(double(db)) }

decl __equal__(Vector3 ref [a, b]){

    //
    return [nIf(a->[x,y,z] == b->[x,y,z])] 
}

decl __negate__(Vector3 ref a){

    //
    return [Vector3(-(a->[x,y,z]))]
}

decl dot(Vector3 ref [a,b]){

    //
    return [sum(a->[x,y,z] * b->[x,y,z])]
}

decl cross(Vector3 ref [a,b]){

    //
    return [Vector3(a->[y,z,x] * b->[z,x,y] - a->[z,x,y] * b->[y,z,x])]
}

decl abs(Vector3 ref [a]){

    //
    return [sqrt(sum(a->[x,y,z] * a->[x,y,z]))]
}

decl normalize(Vector3 ref [a]){

    //
    a->mul(1.0/abs(a))
}