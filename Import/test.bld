// Beispiel Programm in Baldur
// fetch script ["pckg/preDecls", "pckg/Vector3"]

// main des Skript
decl main(){
    
    slog("Hallo Welt")

    tExpr tmp = diff(tExpr("l", args(2,3,6)) + tExpr("m", args(2,3,6)), tExpr("l", args(2,3,6)));

    slog(tmp->getNumOfExternalNodes())
    slog(tmp->getNumOfNodes())

    slog(diff(tExpr("m", 4), tExpr("c", 3)))
}

//
if(calledAs(__MainProc__)){

    return [main()]
}