// Beispiel Programm in Baldur
// fetch script ["pckg/preDecls", "pckg/Vector3"]

// main des Skript
decl main(){
    
    tExpr [tmplA, tmplB] = tExprTmpl("tmplA", -1), tExprTmpl("tmplB", -1)
    tExpr [ArgTmplA, ArgTmplB] = tExprArgTmpl("tmplA"), tExprArgTmpl("B")

    setDiffTemplate(tmplA, tmplA, identity(tmplA \(x) tmplA))
    setDiffTemplate(ArgTmplA, tmplB, zeros(ArgTmplA \(x) tmplB))

    logDiffTemplates()

    slog(diff(tExpr("A", 4) . tExpr("A", 4), tExpr("A", 4)))

    // slog(ArgTmplA)
}

//
if(calledAs(__MainProc__)){

    return [main()]
}