// Beispiel Programm in Baldur
// fetch script ["pckg/preDecls", "pckg/Vector3"]

// main des Skript
decl main(){
    
    slog("Hallo Welt")

    void tmp = tExpr("m", args(1,2,10))
    void tmpB = tExpr("m2", args(2,10,6))

    void A = tExpr("A", 3)
    void B = tExpr("B", 3)

    void tmpTmpl = tExprTmpl("hallo")

    slog(tmp + tmpTmpl)

    slog(tmp : tmpB)
}

//
if(calledAs(__MainProc__)){

    return [main()]
}