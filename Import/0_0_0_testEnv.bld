// ---------------------------------------------------------------------------
//                      Example 0.0.1 recursiveDemo
// ---------------------------------------------------------------------------
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/ProcTestEnv SCRIPT=../Import/0_0_0_testEnv.bld
// - Ohne Interpreter build: $ make exec TARGET=build/ProcTestEnv SCRIPT=../Import/0_0_0_testEnv.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/ProcLang_d execute Import/0_0_0_testEnv.bld

// Includes
fetch backend ["tensor"]
fetch script ["pckg/preDecls", "pckg/functions"]

if(calledAs(__MainProc__)){

    //
    slog("Test Umgebung aufgesetzt")
    slog("------------------------")

    // ...

    tExpr [A, b] = tExpr("A", 2, args(3,3)), tExpr("b", 0)
    tExpr [a, B] = tExpr("a", 1, args(3)), tExpr("B", 2, args(3,3))

    res = frobenius(a) * b

    slog(diff(res, B))

    //
    string tResultLabel = "testEnv"
    tIdn tIDNResult = toIDN(res)
    tIDNResult->toJuliaString(tResultLabel)->writeToFile("../Import/juliaScripts/" + tResultLabel + ".jl")

    //
    slog("------------------------")
    slog("Test Umgebung wird geschlossen ...")
}