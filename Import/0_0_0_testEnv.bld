// ---------------------------------------------------------------------------
//                      Example 0.0.1 recursiveDemo
// ---------------------------------------------------------------------------
// Ausführung des Skripts über Make Target und Spezifikationen
// - Mit Interpreter build: $ make launch TARGET=build/ProcTestEnv SCRIPT=../Import/0_0_0_testEnv.bld
// - Ohne Interpreter build: $ make exec TARGET=build/ProcTestEnv SCRIPT=../Import/0_0_0_testEnv.bld
//
// Ausführung des Skript über Interpreteraufruf (Pfade für CWD Baldur MainDir gegeben)
// $ ./build/ProcLang_d execute Import/0_0_0_testEnv.bld

// Includes
fetch backend ["tensor"]
requires bool uniform g_unwrapOperands

int tmplID
tExpr [tmplScalar, tmplTensor] = tExprTmpl(string(tmplID++), 0), tExprTmpl(string(tmplID++))
tExpr [tmplScalarA, tmplTensorA] = tExprTmpl(string(tmplID++), 0), tExprTmpl(string(tmplID++))
tExpr [zerosInstanceTemplate]  = tExprInstTmpl("zeros")

tExpr [A, B, C] = tExpr("A", 2), tExpr("B", 2), tExpr("C", 2)
tExpr [a, b, c] = tExpr("a", 0), tExpr("b", 0), tExpr("c", 0)

setEqual(tmplScalar * tmplTensor + tmplScalarA * tmplTensor, (tmplScalar + tmplScalarA) * tmplTensor)
setEqual(0 + tmplScalar, tmplScalar)
setEqual(zerosInstanceTemplate + tmplTensor, tmplTensor)
setEqual(0 * tmplTensor, zeros(tmplTensor))
setEqual(1 * tmplTensor, tmplTensor)

tExpr expr = 0.5 * A + (-0.5) * A

slog(simplified(expr))